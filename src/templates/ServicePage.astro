---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CtaBand from '../components/CtaBand.astro';
import BrandsStrip from '../components/BrandsStrip.astro';
import FAQ from '../components/FAQ.astro';
import { faqPageSchema } from '../lib/faqSchema';
import { SERVICE_FAQS } from '../content/serviceFaqs';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'services'>;
}
const { entry } = Astro.props;
const [lang, slug] = entry.id.split('/') as [Lang, string];
const t = useTranslations(lang);
const { title, metaDescription, heroTitle, heroImage, sections, whyChooseUs, category, navLabel } = entry.data;
const categoryLabel = t(`service.category.${category}` as const);

const pageUrl = new URL(localizePath(`/${slug}/`, lang), Astro.site).toString();
const ogImageUrl = new URL(heroImage.src, Astro.site).toString();
const faqItems = SERVICE_FAQS[lang][slug];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: navLabel,
  description: metaDescription,
  provider: { '@id': 'https://redworks.es/#organization' },
  areaServed: { '@type': 'City', name: 'Madrid' },
  serviceType: navLabel,
  url: pageUrl,
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.inicio'), item: new URL(localizePath('/', lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t('breadcrumb.servicios'), item: new URL(localizePath('/#servicios', lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: navLabel, item: pageUrl },
  ],
};

const pageSchema = faqItems
  ? [serviceSchema, breadcrumbSchema, faqPageSchema(faqItems)]
  : [serviceSchema, breadcrumbSchema];
---

<Layout
  title={`${title} | Redworks`}
  description={metaDescription}
  ogImage={ogImageUrl}
  schema={pageSchema}
>
  <Hero title={heroTitle} image={heroImage} imageAlt={`${navLabel} — Redworks Solutions`} eyebrow={categoryLabel} />
  {
    sections.map((section) => (
      <section class="content-section container">
        <h2>{section.heading}</h2>
        {section.body && <p>{section.body}</p>}
        {section.image && (
          <Image src={section.image} alt={`${section.heading} — ${navLabel.toLowerCase()} — Redworks Solutions`} width={900} height={675} />
        )}
      </section>
    ))
  }
  {whyChooseUs && whyChooseUs.length > 0 && <WhyChooseUs cards={whyChooseUs} />}
  {faqItems && <FAQ items={faqItems} title={`${t('faq.about_prefix')} ${navLabel.toLowerCase()}`} />}
  <CtaBand />
  <BrandsStrip />
</Layout>

<style>
  .content-section {
    padding: 2rem 0;
    max-width: 800px;
  }
  .content-section img {
    margin-top: 1rem;
    border-radius: var(--radius);
  }
</style>
