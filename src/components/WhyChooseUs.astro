---
import Icon from './Icon.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';

interface Card {
  icon: string;
  title: string;
  body: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="why container">
  <p class="eyebrow">{t('why.eyebrow')}</p>
  <h2>{t('why.heading')}</h2>
  <div class="cards">
    {
      cards.map((card) => (
        <div class="card">
          <Icon name={card.icon} />
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .why {
    padding: 3rem 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .card {
    color: var(--blue);
  }
  .card h3,
  .card p {
    color: var(--text);
  }
</style>
