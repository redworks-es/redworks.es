---
import { useTranslations, localizePath, getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="cta">
  <div class="container">
    <p class="eyebrow">{t('cta.eyebrow')}</p>
    <h2>{t('cta.heading')}</h2>
    <p class="lede">
      {t('cta.lede')}
    </p>
    <div class="actions">
      <a class="button" href="tel:+34910527499">{t('cta.call')}</a>
      <a class="button secondary" href={localizePath('/contacto/', lang)}>{t('cta.write')}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--ink);
    color: #fff;
    padding: 3.5rem 0;
    text-align: center;
    border-top: 3px solid var(--red);
  }
  .cta .eyebrow {
    color: #6fb8e6;
  }
  .cta h2 {
    color: #fff;
  }
  .cta .lede {
    max-width: 600px;
    margin: 0 auto 1.5rem;
    color: #c3ccdc;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .button.secondary {
    background: #fff;
    color: var(--blue);
  }
  .button.secondary:hover {
    background: #eee;
  }
</style>
