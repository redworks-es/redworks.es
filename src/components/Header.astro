---
import { Image } from 'astro:assets';
import logo from '../assets/shared/logo.png';
import { useTranslations, localizePath, swapLangInPath, getLangFromUrl } from '../i18n/utils';

const SERVICES_BY_LANG = {
  es: [
    { label: 'Telecomunicaciones', slug: 'telecomunicaciones' },
    { label: 'Telefonía VoIP', slug: 'telefonia-voip' },
    { label: 'Audiovisuales', slug: 'audiovisuales' },
    { label: 'Videoconferencias', slug: 'videoconferencias' },
    { label: 'Megafonía', slug: 'megafonia' },
    { label: 'Sala de conferencias', slug: 'conferencias' },
    { label: 'Redes informáticas', slug: 'sistemas-informaticos' },
    { label: 'Redes wifi', slug: 'redes-wifi' },
    { label: 'Sistema de seguridad', slug: 'seguridad' },
    { label: 'Electricidad', slug: 'electricidad' },
    { label: 'Paneles solares', slug: 'paneles' },
    { label: 'Instalación eléctrica de baja tensión', slug: 'instalacion-electrica-de-baja-tension' },
  ],
  fr: [
    { label: 'Télécommunications', slug: 'telecomunicaciones' },
    { label: 'Téléphonie VoIP', slug: 'telefonia-voip' },
    { label: 'Audiovisuel', slug: 'audiovisuales' },
    { label: 'Visioconférences', slug: 'videoconferencias' },
    { label: 'Sonorisation', slug: 'megafonia' },
    { label: 'Salle de conférence', slug: 'conferencias' },
    { label: 'Réseaux informatiques', slug: 'sistemas-informaticos' },
    { label: 'Réseaux wifi', slug: 'redes-wifi' },
    { label: 'Système de sécurité', slug: 'seguridad' },
    { label: 'Électricité', slug: 'electricidad' },
    { label: 'Panneaux solaires', slug: 'paneles' },
    { label: 'Installation électrique basse tension', slug: 'instalacion-electrica-de-baja-tension' },
  ],
} as const;

const PAGES_BY_LANG = {
  es: [
    { label: 'Clientes', slug: 'clientes' },
    { label: 'Quiénes somos', slug: 'quienes-somos' },
    { label: 'Blog', slug: 'blog' },
    { label: 'Contacto', slug: 'contacto' },
  ],
  fr: [
    { label: 'Clients', slug: 'clientes' },
    { label: 'Qui sommes-nous', slug: 'quienes-somos' },
    { label: 'Blog', slug: 'blog' },
    { label: 'Contact', slug: 'contacto' },
  ],
} as const;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const SERVICES = SERVICES_BY_LANG[lang].map((item) => ({ label: item.label, href: localizePath(`/${item.slug}/`, lang) }));
const PAGES = PAGES_BY_LANG[lang].map((item) => ({ label: item.label, href: localizePath(`/${item.slug}/`, lang) }));

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href;
const isInServices = SERVICES.some((item) => isActive(item.href));
const otherLang = lang === 'es' ? 'fr' : 'es';
const otherLangHref = swapLangInPath(currentPath, otherLang);
---

<header class="site-header">
  <div class="container bar">
    <a href={localizePath('/', lang)} class="logo">
      <Image src={logo} alt="Redworks Solutions" width={170} height={41} />
    </a>

    <nav class="main-nav" aria-label={t('nav.aria_principal')}>
      <ul class="main-menu">
        <li class="has-dropdown">
          <span class:list={{ active: isInServices }}>{t('nav.services')}</span>
          <ul class="dropdown">
            {
              SERVICES.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          PAGES.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="side-actions">
      <a class="lang-switch" href={otherLangHref} hreflang={otherLang} aria-label={t('language.switch_label')}>
        {otherLang.toUpperCase()}
      </a>
      <a class="phone" href="tel:+34910527499">910 52 74 99</a>
    </div>

    <details class="mobile-nav">
      <summary aria-label={t('nav.open_menu')}>
        <span></span><span></span><span></span>
      </summary>
      <ul class="mobile-menu">
        <li class="mobile-heading">{t('nav.services')}</li>
        {
          SERVICES.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mobile-heading">{t('nav.mobile_company')}</li>
        {
          PAGES.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mobile-heading">{t('language.switch_label')}</li>
        <li>
          <a href={otherLangHref} hreflang={otherLang}>{otherLang.toUpperCase()}</a>
        </li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--wire);
    background: var(--white);
    position: relative;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.5rem;
    gap: 1.5rem;
  }
  .logo {
    display: block;
    flex-shrink: 0;
  }
  .logo img {
    display: block;
    height: 34px;
    width: auto;
  }
  .main-nav {
    flex: 1;
  }
  .main-menu {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.94rem;
  }
  .main-menu a,
  .has-dropdown > span {
    color: var(--text);
  }
  .main-menu a:hover {
    color: var(--blue);
    text-decoration: none;
  }
  .main-menu a[aria-current='page'] {
    color: var(--blue);
    font-weight: 600;
  }
  .main-menu > li {
    position: relative;
  }
  .has-dropdown > span {
    cursor: default;
    font-weight: 500;
  }
  .has-dropdown > span.active {
    color: var(--blue);
    font-weight: 600;
  }
  .dropdown {
    display: none;
    list-style: none;
    margin: 0;
    position: absolute;
    top: calc(100% + 1.1rem);
    left: -1rem;
    background: var(--white);
    border: 1px solid var(--wire);
    border-radius: var(--radius);
    padding: 0.5rem 0;
    min-width: 270px;
    flex-direction: column;
    z-index: 10;
    box-shadow: 0 12px 24px -8px rgba(11, 18, 32, 0.18);
  }
  .has-dropdown:hover .dropdown {
    display: flex;
  }
  .dropdown li a {
    display: block;
    padding: 0.45rem 1.1rem;
    font-size: 0.9rem;
  }
  .dropdown li a[aria-current='page'] {
    color: var(--blue);
    font-weight: 600;
    background: var(--paper);
  }
  .side-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .phone {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--text);
    white-space: nowrap;
  }
  .phone:hover {
    color: var(--blue);
  }
  .lang-switch {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    border: 1px solid var(--wire);
    border-radius: var(--radius);
    padding: 0.25rem 0.55rem;
  }
  .lang-switch:hover {
    color: var(--blue);
    border-color: var(--blue);
    text-decoration: none;
  }

  .mobile-nav {
    display: none;
  }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0.4rem;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary span {
    width: 22px;
    height: 2px;
    background: var(--text);
    display: block;
  }
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--white);
    border-top: 1px solid var(--wire);
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1rem;
    max-height: 75vh;
    overflow-y: auto;
    box-shadow: 0 12px 24px -8px rgba(11, 18, 32, 0.18);
  }
  .mobile-menu li a {
    display: block;
    padding: 0.55rem 1.5rem;
    color: var(--text);
  }
  .mobile-menu li a[aria-current='page'] {
    color: var(--blue);
    font-weight: 600;
    background: var(--paper);
  }
  .mobile-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.9rem 1.5rem 0.2rem;
  }

  @media (max-width: 860px) {
    .main-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
